        <!-- Agent 1: Planner -->
        <mxCell id="a1" value="&lt;font style='font-size:16px'&gt;&lt;b&gt;1. PLANNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;hr size='1'&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Role:&lt;/b&gt; Intent Classifier&lt;br&gt;&lt;br&gt;&lt;b&gt;Layer 1 - Regex (Fast):&lt;/b&gt;&lt;br&gt;- Leave: apply/approve/reject&lt;br&gt;- Column: add field salary INT&lt;br&gt;- Employee: add/update/delete&lt;br&gt;- Deploy: deploy to github&lt;br&gt;- Query: show/list/count&lt;br&gt;&lt;br&gt;&lt;b&gt;Layer 2 - Gemini AI:&lt;/b&gt;&lt;br&gt;- Complex intent routing&lt;br&gt;- Returns task_type JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eab308;strokeWidth=2;fontSize=11;align=left;spacingLeft=12;shadow=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1185" width="195" height="260" as="geometry" />
        </mxCell>

        <!-- Agent 2: Coder -->
        <mxCell id="a2" value="&lt;font style='font-size:16px'&gt;&lt;b&gt;2. CODER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;hr size='1'&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Role:&lt;/b&gt; SQL Generator&lt;br&gt;&lt;br&gt;&lt;b&gt;SQL Operations:&lt;/b&gt;&lt;br&gt;- INSERT (full employee data)&lt;br&gt;- UPDATE (multi-field SET)&lt;br&gt;- DELETE (name-based)&lt;br&gt;- ALTER TABLE (auto datatype)&lt;br&gt;- SELECT (with filters)&lt;br&gt;&lt;br&gt;&lt;b&gt;Code Edit:&lt;/b&gt;&lt;br&gt;- Reads/writes App.jsx&lt;br&gt;- Gemini generates code&lt;br&gt;&lt;br&gt;&lt;b&gt;Datatype Inference:&lt;/b&gt;&lt;br&gt;salary=INT, dob=DATE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eab308;strokeWidth=2;fontSize=11;align=left;spacingLeft=12;shadow=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
